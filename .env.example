# Copie para .env (gitignored). O docker-compose lê este arquivo se existir.
# Em produção os mesmos nomes vêm do ConfigMap/Secret (cd/prod/).

# --- URLs (dev: API em :3100, front em :3101) ---
API_URL=http://localhost:3100            # base do redirect_uri do OAuth: <API_URL>/auth/ml/callback
FRONT_URL=http://localhost:3101          # para onde o callback do ML devolve o usuário
CORS_ORIGINS=http://localhost:3101       # origens do front, separadas por vírgula
# API_HOST=api.seudominio.com.br         # produção: host aceito pelo Rails (config.hosts)

# --- App do Mercado Livre (DevCenter) — única configuração global do ML ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# --- Claude API (plano de ação com IA) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Banco (dev/test usam DB_*; produção usa DATABASE_URL) ---
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL=10
# DATABASE_URL=postgres://lunna_api:senha@lunna-postgres:5432/lunna_api_production

# --- Produção (gerar do zero; ver cd/prod/README.md) ---
# SECRET_KEY_BASE=
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# RAILS_MAX_THREADS=5
# JOB_CONCURRENCY=1
# TRUSTED_PROXIES=10.0.0.0/8
